# Copy this file to "api/.env" and fill in your values.
# Never upload .env to GitHub. It is already listed in .gitignore.

# development on your PC, production on the hosting
APP_ENV=development
# Show error details in API responses. Always false on the live site.
APP_DEBUG=false
# Your website address, without a trailing slash.
APP_URL=http://localhost:5173

# ---------------------------------------------------------------- Database
# mysql (XAMPP on your PC, cPanel on the hosting) or sqlite (quick local test)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hyperbyte
DB_USER=root
DB_PASS=

# Only used when DB_DRIVER=sqlite
# DB_PATH=storage/hyperbyte.sqlite

# ---------------------------------------------------------------- First admin
# A long random secret used ONCE on the /admin/setup page to create the
# first admin account. Remove it after setup.
SETUP_TOKEN=

# ---------------------------------------------------------------- Optional
# Set to true only if your host sits behind a proxy/CDN that sends X-Forwarded-For.
TRUST_PROXY=false
# Where photos are saved. Default: the "uploads" folder next to the api folder.
# UPLOAD_DIR=
